1.write a c program the given number is positive or negative or 0
//i/p           o/p
//12            number is 12 : positive
//-4            number is -4 : negative
//0             number is 0 
#include <stdio.h>
int main()
{
    int a;
    scanf("%d",&a);
    if(a>0)
    printf("the number is %d : positive",a);
    else if(a<0)
    printf("the number is %d : negative",a);
    else
    printf("the number is 0");
}

