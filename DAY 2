3.GREATEST OF 3 NUMBERS
#include<stdio.h>
int main()
{
    int a,b,c;
    scanf("%d%d%d",&a,&b,&c);
    if ((a>b)&&(a>c))
    printf("greater is = %d",a);
    else if (b>c)
    printf("greater is = %d",b);
    else
    printf("greater is = %d",c);
}
